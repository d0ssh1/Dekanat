# Скопируйте в .env и заполните. Файл .env никогда не коммитится.

# Подключение приложения: роль app_user (без прав суперпользователя, RLS действует)
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:54329/dekanat
# Подключение для миграций и сида: владелец схемы
DATABASE_OWNER_URL=postgres://dekanat_owner:CHANGE_ME@localhost:54329/dekanat
# Пароль для роли app_user, который миграция установит при создании роли
APP_DB_PASSWORD=CHANGE_ME

# Часовой пояс вуза (ДВФУ — Владивосток)
UNIVERSITY_TZ=Asia/Vladivostok

# Публичный адрес сайта (для QR-кодов справок)
PUBLIC_URL=http://localhost:3000

# Хранилище файлов: disk | s3
STORAGE_DRIVER=disk
STORAGE_DIR=./storage

# GigaChat: ключ авторизации (Authorization key) из developers.sber.ru. Пусто → помощник работает на правилах
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Адрес API (по умолчанию пробуются https://api.giga.chat/v1 и прежний gigachat.devices.sberbank.ru)
GIGACHAT_API_BASE=
# Корневой сертификат НУЦ Минцифры для TLS GigaChat (путь к .crt на сервере)
NODE_EXTRA_CA_CERTS=

# Пароли тестовых аккаунтов для сида (не коммитить настоящие значения)
SEED_PASSWORD_STUDENT1=
SEED_PASSWORD_STUDENT2=
SEED_PASSWORD_STAFF=
